<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Anjani 🌸</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Italiana&family=DM+Sans:wght@300;400&display=swap" rel="stylesheet">
<style>
* { margin:0; padding:0; box-sizing:border-box; }
:root {
  --ink:#0a0612; --cream:#f5ede0; --sakura:#ffb7c5; --sky:#7ec8e3;
  --gold:#e8c96a; --violet:#9b5de5; --soft:#ffe0ec; --dark:#1a0a2e;
}
html { scroll-behavior:smooth; }
body { background:var(--ink); color:var(--cream); font-family:'DM Sans',sans-serif; overflow-x:hidden; }

/* ── SAKURA PETALS ── */
.petals { position:fixed; inset:0; pointer-events:none; z-index:0; overflow:hidden; }
.petal {
  position:absolute; top:-40px; font-size:var(--fs,1rem);
  animation:petalFall var(--d,8s) var(--dl,0s) linear infinite;
  opacity:0.7;
}
@keyframes petalFall {
  0%   { transform:translateY(-40px) translateX(0) rotate(0deg); opacity:0.8; }
  50%  { transform:translateY(50vh) translateX(var(--sway,30px)) rotate(180deg); opacity:0.6; }
  100% { transform:translateY(110vh) translateX(0) rotate(360deg); opacity:0; }
}

/* ── HERO ── */
.hero { position:relative; height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; overflow:hidden; z-index:1; }
.hero-bg { position:absolute; inset:0; background:radial-gradient(ellipse 90% 70% at 50% 40%, #1a0a2e 0%, #0a0612 70%); }

/* Decorative grid lines */
.grid-lines { position:absolute; inset:0; pointer-events:none; }
.grid-lines::before { content:''; position:absolute; inset:0; background:repeating-linear-gradient(0deg,transparent,transparent 60px,rgba(155,93,229,0.04) 60px,rgba(155,93,229,0.04) 61px), repeating-linear-gradient(90deg,transparent,transparent 60px,rgba(155,93,229,0.04) 60px,rgba(155,93,229,0.04) 61px); }

/* Glowing orbs */
.orb { position:absolute; border-radius:50%; filter:blur(90px); pointer-events:none; animation:orbFloat var(--od,15s) ease-in-out infinite alternate; }
.orb1 { width:500px; height:500px; top:-100px; right:-100px; background:radial-gradient(circle,rgba(155,93,229,0.18),transparent); --od:18s; }
.orb2 { width:400px; height:400px; bottom:-80px; left:-80px; background:radial-gradient(circle,rgba(255,183,197,0.15),transparent); --od:14s; }
.orb3 { width:300px; height:300px; top:50%; left:50%; background:radial-gradient(circle,rgba(126,200,227,0.1),transparent); --od:22s; }
@keyframes orbFloat { from{transform:translate(0,0) scale(1)} to{transform:translate(3%,5%) scale(1.08)} }

/* Floating stars */
.stars-bg { position:absolute; inset:0; pointer-events:none; }
.star { position:absolute; animation:twinkle var(--sd,3s) var(--sdl,0s) infinite ease-in-out alternate; }
@keyframes twinkle { from{opacity:0.1;transform:scale(0.6)} to{opacity:0.9;transform:scale(1.3)} }

.hero-content { position:relative; z-index:2; text-align:center; padding:0 24px; }

.eyebrow { font-family:'DM Sans',sans-serif; font-weight:300; font-size:0.7rem; letter-spacing:0.4em; color:var(--sakura); text-transform:uppercase; margin-bottom:24px; opacity:0; animation:revealUp 1s 0.3s forwards; }

/* Name with glow */
.hero-name { font-family:'Italiana',serif; font-size:clamp(4.5rem,16vw,12rem); line-height:0.88; color:var(--cream); opacity:0; animation:revealUp 1.2s 0.5s cubic-bezier(.16,1,.3,1) forwards; position:relative; display:inline-block; }
.hero-name .glow-text { display:block; color:transparent; -webkit-text-stroke:1.5px var(--sakura); font-style:italic; text-shadow:none; filter:drop-shadow(0 0 20px rgba(255,183,197,0.6)); }

/* Decorative brackets */
.bracket { display:inline-block; color:var(--violet); font-size:clamp(3rem,10vw,8rem); font-family:'Italiana',serif; vertical-align:middle; opacity:0.5; }

.hero-sub { font-family:'Cormorant Garamond',serif; font-style:italic; font-size:clamp(0.95rem,2.5vw,1.35rem); font-weight:300; color:rgba(245,237,224,0.5); margin-top:20px; letter-spacing:0.06em; opacity:0; animation:revealUp 1s 0.9s forwards; }

/* Badge */
.anime-badge { display:inline-flex; align-items:center; gap:8px; margin-top:20px; padding:6px 18px; border:1px solid rgba(155,93,229,0.4); border-radius:50px; background:rgba(155,93,229,0.08); font-size:0.72rem; letter-spacing:0.2em; color:var(--violet); text-transform:uppercase; opacity:0; animation:revealUp 1s 1.1s forwards; }

.scroll-hint { position:absolute; bottom:36px; left:50%; transform:translateX(-50%); z-index:2; display:flex; flex-direction:column; align-items:center; gap:8px; opacity:0; animation:revealUp 1s 1.5s forwards; }
.scroll-hint span { font-size:0.62rem; letter-spacing:0.3em; color:rgba(245,237,224,0.3); text-transform:uppercase; }
.scroll-line { width:1px; height:44px; background:linear-gradient(to bottom,rgba(255,183,197,0.6),transparent); animation:sPulse 2s infinite; }
@keyframes sPulse { 0%,100%{opacity:0.3;transform:scaleY(1)} 50%{opacity:1;transform:scaleY(1.3)} }
@keyframes revealUp { from{opacity:0;transform:translateY(40px)} to{opacity:1;transform:translateY(0)} }

/* ── DIVIDER ── */
.divider { display:flex; align-items:center; gap:16px; padding:0 40px; margin:60px 0 44px; position:relative; z-index:1; }
.div-line { flex:1; height:1px; background:linear-gradient(to right,transparent,rgba(255,183,197,0.3),transparent); }
.div-mark { color:var(--sakura); font-size:1rem; letter-spacing:0.5em; }

/* ── PHOTOS ── */
.photos-section { padding:0 24px 80px; max-width:900px; margin:0 auto; position:relative; z-index:1; }
.photos-grid { display:grid; grid-template-columns:1.4fr 1fr 1fr 1.2fr; grid-template-rows:200px 200px; gap:10px; }
.photo-card { position:relative; overflow:hidden; border-radius:2px; cursor:pointer; border:1px solid rgba(155,93,229,0.15); }
.photo-card:nth-child(1) { grid-row:span 2; }
.photo-card:nth-child(4) { grid-row:span 2; }
.photo-card img { width:100%; height:100%; object-fit:cover; object-position:top center; transition:transform 0.7s cubic-bezier(.16,1,.3,1),filter 0.5s; filter:saturate(0.65) brightness(0.88); display:block; }
.photo-card:hover img { transform:scale(1.07); filter:saturate(1.1) brightness(1.05); }
.photo-card::after { content:''; position:absolute; inset:0; background:linear-gradient(to top,rgba(10,6,18,0.65) 0%,transparent 55%); pointer-events:none; }
/* Corner decoration */
.photo-card::before { content:''; position:absolute; top:6px; right:6px; width:14px; height:14px; border-top:1.5px solid var(--sakura); border-right:1.5px solid var(--sakura); z-index:3; opacity:0.6; }
.photo-label { position:absolute; bottom:10px; left:12px; z-index:2; font-size:0.6rem; letter-spacing:0.25em; color:rgba(245,237,224,0.55); text-transform:uppercase; }

/* ── MESSAGE ── */
.message-section { max-width:660px; margin:0 auto; padding:0 32px 90px; text-align:center; position:relative; z-index:1; }

/* Quote box */
.quote-box { position:relative; margin-bottom:44px; padding:32px 28px; border:1px solid rgba(155,93,229,0.2); border-radius:2px; background:rgba(155,93,229,0.04); }
.quote-box::before { content:'"'; font-family:'Italiana',serif; font-size:5rem; color:var(--violet); position:absolute; top:-20px; left:20px; opacity:0.4; line-height:1; }
.quote-box::after { content:'"'; font-family:'Italiana',serif; font-size:5rem; color:var(--violet); position:absolute; bottom:-40px; right:20px; opacity:0.4; line-height:1; }
.msg-quote { font-family:'Cormorant Garamond',serif; font-style:italic; font-size:clamp(1.3rem,3.5vw,2rem); font-weight:300; line-height:1.5; color:var(--cream); }
.msg-quote em { color:var(--sakura); font-style:normal; }

.msg-body { font-size:0.92rem; font-weight:300; line-height:2.0; color:rgba(245,237,224,0.6); margin-bottom:50px; margin-top:16px; }
.msg-body strong { color:var(--sakura); font-weight:400; }
.msg-body .special-ref { color:var(--sky); font-style:italic; }

/* ── BUTTON ── */
.btn-section { text-align:center; margin-bottom:100px; position:relative; z-index:1; }
.btn-hint { font-family:'Cormorant Garamond',serif; font-style:italic; font-size:0.95rem; color:rgba(245,237,224,0.35); margin-bottom:44px; letter-spacing:0.05em; }

/* Card button */
.anime-btn-wrap { position:relative; display:inline-block; }

/* Floating sparkles around button */
.sparkle-ring { position:absolute; inset:-30px; pointer-events:none; }
.sp { position:absolute; font-size:0.9rem; animation:spFloat var(--sd,3s) var(--sdl,0s) ease-in-out infinite alternate; }
@keyframes spFloat { from{transform:translateY(0) scale(1);opacity:0.7} to{transform:translateY(-8px) scale(1.3);opacity:1} }

.anime-btn {
  position:relative; display:flex; flex-direction:column;
  align-items:center; justify-content:center;
  width:180px; height:240px;
  border:none; background:transparent; cursor:pointer;
  font-family:inherit;
}

/* Card body */
.btn-card {
  position:relative; width:180px; height:240px;
  border-radius:12px;
  background:linear-gradient(145deg, #1e0a38, #2d1060, #1a0a2e);
  border:1.5px solid rgba(155,93,229,0.5);
  display:flex; flex-direction:column;
  align-items:center; justify-content:center; gap:10px;
  overflow:hidden;
  transition:transform 0.4s cubic-bezier(.16,1,.3,1), box-shadow 0.4s;
  box-shadow: 0 0 30px rgba(155,93,229,0.2), inset 0 0 30px rgba(155,93,229,0.05);
}

/* Holographic shimmer */
.btn-card::before {
  content:'';
  position:absolute; inset:0;
  background:linear-gradient(135deg, transparent 30%, rgba(255,183,197,0.08) 50%, transparent 70%);
  animation:shimmer 3s ease-in-out infinite;
  border-radius:inherit;
}
@keyframes shimmer {
  0%   { transform:translateX(-100%) translateY(-100%) rotate(45deg); }
  100% { transform:translateX(100%) translateY(100%) rotate(45deg); }
}

/* Card corner ornaments */
.btn-card::after {
  content:'';
  position:absolute; inset:6px;
  border-radius:8px;
  border:1px solid rgba(255,183,197,0.15);
  pointer-events:none;
}

.anime-btn:hover .btn-card {
  transform:translateY(-8px) scale(1.04);
  box-shadow:0 20px 60px rgba(155,93,229,0.45), 0 0 100px rgba(255,183,197,0.15), inset 0 0 40px rgba(155,93,229,0.1);
}

.btn-star { font-size:0.65rem; letter-spacing:0.3em; color:rgba(255,183,197,0.5); text-transform:uppercase; }
.btn-cake { font-size:3.2rem; filter:drop-shadow(0 0 16px rgba(255,183,197,0.8)); animation:cakeSpin 4s ease-in-out infinite alternate; z-index:1; }
@keyframes cakeSpin { from{transform:scale(1) rotate(-3deg)} to{transform:scale(1.1) rotate(3deg)} }
.btn-label { font-family:'Cormorant Garamond',serif; font-style:italic; font-size:1.05rem; color:var(--cream); letter-spacing:0.08em; z-index:1; }
.btn-sub { font-size:0.62rem; letter-spacing:0.25em; color:var(--sakura); text-transform:uppercase; z-index:1; }

/* Pulsing aura */
.btn-aura {
  position:absolute; inset:-2px; border-radius:14px;
  border:1px solid rgba(155,93,229,0.3);
  animation:auraPulse 2s ease-in-out infinite;
}
.btn-aura:nth-child(2) { inset:-10px; border-color:rgba(155,93,229,0.15); animation-delay:0.4s; border-radius:20px; }
.btn-aura:nth-child(3) { inset:-20px; border-color:rgba(155,93,229,0.07); animation-delay:0.8s; border-radius:26px; }
@keyframes auraPulse {
  0%,100%{opacity:0.6;transform:scale(1)}
  50%{opacity:1;transform:scale(1.02)}
}

/* ── EXPLOSION ── */
#explosion { position:fixed; inset:0; z-index:2000; display:none; flex-direction:column; align-items:center; justify-content:center; }
#explosion.active { display:flex; }
.exp-bg { position:fixed; inset:0; background:rgba(5,2,12,0.94); backdrop-filter:blur(10px); opacity:0; animation:fadeIn 0.4s forwards; }
@keyframes fadeIn { to{opacity:1} }
.exp-content { position:relative; z-index:2; text-align:center; padding:40px 28px; opacity:0; transform:scale(0.5) translateY(30px); animation:popIn 0.9s 0.25s cubic-bezier(.16,1,.3,1) forwards; max-width:480px; }
@keyframes popIn { to{opacity:1;transform:scale(1) translateY(0)} }

/* Panel style */
.exp-panel { background:linear-gradient(145deg,rgba(30,10,56,0.9),rgba(10,6,18,0.95)); border:1.5px solid rgba(155,93,229,0.4); border-radius:12px; padding:40px 32px; position:relative; overflow:hidden; }
.exp-panel::before { content:''; position:absolute; inset:0; background:repeating-linear-gradient(45deg,transparent,transparent 20px,rgba(155,93,229,0.015) 20px,rgba(155,93,229,0.015) 21px); }
.exp-panel-corner { position:absolute; width:20px; height:20px; }
.exp-panel-corner.tl { top:8px; left:8px; border-top:2px solid var(--sakura); border-left:2px solid var(--sakura); }
.exp-panel-corner.tr { top:8px; right:8px; border-top:2px solid var(--sakura); border-right:2px solid var(--sakura); }
.exp-panel-corner.bl { bottom:8px; left:8px; border-bottom:2px solid var(--sakura); border-left:2px solid var(--sakura); }
.exp-panel-corner.br { bottom:8px; right:8px; border-bottom:2px solid var(--sakura); border-right:2px solid var(--sakura); }

.big-cake { font-size:6rem; line-height:1; filter:drop-shadow(0 0 40px rgba(255,183,197,0.9)) drop-shadow(0 0 20px rgba(155,93,229,0.7)); animation:cakeFloat 2s ease-in-out infinite alternate; margin-bottom:8px; }
@keyframes cakeFloat { from{transform:translateY(0) rotate(-3deg)} to{transform:translateY(-14px) rotate(3deg)} }

.exp-number { font-family:'Italiana',serif; font-size:clamp(4rem,16vw,8rem); line-height:0.9; background:linear-gradient(135deg,var(--gold),var(--sakura),var(--violet)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; margin:4px 0 12px; }

.exp-wish { font-family:'Cormorant Garamond',serif; font-style:italic; font-size:clamp(1.3rem,4vw,1.9rem); font-weight:300; color:var(--cream); margin-bottom:8px; line-height:1.4; }
.exp-sub { font-size:0.78rem; letter-spacing:0.2em; color:rgba(255,183,197,0.55); text-transform:uppercase; margin-bottom:28px; }
.exp-close { display:inline-block; padding:10px 28px; border:1px solid rgba(155,93,229,0.4); border-radius:4px; background:rgba(155,93,229,0.1); color:var(--cream); font-family:'DM Sans',sans-serif; font-size:0.78rem; letter-spacing:0.15em; text-transform:uppercase; cursor:pointer; transition:all 0.3s; }
.exp-close:hover { background:rgba(155,93,229,0.25); border-color:rgba(155,93,229,0.7); }

/* PARTICLES */
.conf { position:fixed; pointer-events:none; z-index:2001; animation:cDrop var(--d,3s) var(--dl,0s) forwards ease-in; }
@keyframes cDrop { 0%{transform:translateY(-50px) rotate(0deg);opacity:1} 100%{transform:translateY(110vh) rotate(var(--rot,540deg));opacity:0} }
.fw { position:fixed; width:5px; height:5px; border-radius:50%; pointer-events:none; z-index:2001; animation:fwOut var(--d,1s) var(--dl,0s) forwards ease-out; }
@keyframes fwOut { 0%{transform:translate(0,0);opacity:1} 100%{transform:translate(var(--tx,0px),var(--ty,0px));opacity:0} }

/* ── FOOTER ── */
footer { text-align:center; padding:56px 24px; border-top:1px solid rgba(245,237,224,0.05); position:relative; z-index:1; }
footer p { font-family:'Cormorant Garamond',serif; font-style:italic; font-size:0.85rem; color:rgba(245,237,224,0.22); letter-spacing:0.1em; }
.heart { color:var(--sakura); }

@media(max-width:600px){
  .photos-grid { grid-template-columns:1fr 1fr; grid-template-rows:auto; }
  .photo-card:nth-child(1),.photo-card:nth-child(4) { grid-row:span 1; }
  .photos-grid .photo-card img { min-height:160px; }
}
</style>
</head>
<body>

<!-- Sakura petals -->
<div class="petals" id="petals"></div>

<!-- HERO -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="grid-lines"></div>
  <div class="orb orb1"></div><div class="orb orb2"></div><div class="orb orb3"></div>
  <div class="stars-bg" id="starsBg"></div>

  <div class="hero-content">
    <p class="eyebrow">June 4th &nbsp;·&nbsp; A Memorable Day</p>
    <div style="opacity:0;animation:revealUp 1.2s 0.5s cubic-bezier(.16,1,.3,1) forwards;">
      <span class="bracket">〔</span>
      <span class="hero-name">Anjani<span class="glow-text">turns 17</span></span>
      <span class="bracket">〕</span>
    </div>
    <p class="hero-sub">To a classmate who made every ordinary school day a little more memorable.</p>
    <div class="anime-badge">✦ &nbsp; Class of Memories &nbsp; ✦</div>
  </div>

  <div class="scroll-hint">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<!-- DIVIDER -->
<div class="divider" style="position:relative;z-index:1;">
  <div class="div-line"></div>
  <div class="div-mark">❀ ✦ ❀</div>
  <div class="div-line"></div>
</div>

<!-- PHOTOS -->
<section class="photos-section">
  <div class="photos-grid">
    <div class="photo-card"><img src="data:image/jpeg;base64,